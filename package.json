{
  "name": "gofer-trace-trueforge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n MCP,FORGE,UI -c green,magenta,cyan \"npm:dev:mcp\" \"npm:dev:trueforge\" \"npm:dev:ui\"",
    "dev:mcp": "python app.py",
    "dev:trueforge": "cross-env LOCALAPPDATA=.trueforge-data SQLITE_PATH=.trueforge-data/db.sqlite NODE_OPTIONS=--experimental-loader=./scripts/windows-esm-loader.mjs trueforge --port 8790",
    "dev:ui": "vite --configLoader runner --host 127.0.0.1 --port 5173",
    "configure:trueforge": "node --env-file-if-exists=.env scripts/configure-trueforge.mjs",
    "build": "tsc -b && vite --configLoader runner build",
    "typecheck": "tsc -b",
    "preview": "vite --configLoader runner preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@truefoundry/trueforge": "^0.1.4",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "@truefoundry/trueforge-ui": "^0.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
